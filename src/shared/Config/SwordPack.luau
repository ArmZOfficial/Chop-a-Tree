local list: { Sword } = {}
local byId: { [string]: Sword } = {}
for _, r in rows do
	local w: Sword = table.freeze({
		id = r[1], name = r[2], thai = r[3], rarity = R[r[4]], element = r[5] > 0 and E[r[5]] or nil,
		move = r[6] ~= "" and r[6] or nil, basePower = r[7], speed = r[8], area = r[9],
		swordShape = S[r[10]], guardStyle = G[r[11]], handleStyle = H[r[12]],
	}) :: any
	assert(byId[w.id] == nil, "duplicate sword id " .. w.id)
	byId[w.id] = w
	table.insert(list, w)
end

return table.freeze({ List = table.freeze(list), ById = table.freeze(byId) })
